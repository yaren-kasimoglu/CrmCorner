@model CrmCorner.Controllers.PipelineAnalysisPageViewModel
@using CrmCorner.Extensions
@using CrmCorner.Models.Enums

@{
    ViewData["Title"] = "Pipeline Analizi";
    Layout = "~/Views/Shared/_LayoutHomePage.cshtml";

    int usersCount = Model.Rows.Count;
    int totalAll = Model.Rows.Sum(r => r.Total);
    int wonAll = Model.Rows.Sum(r => r.OutcomeCounts.TryGetValue(OutcomeTypeSales.Won, out var w) ? w : 0);
    double winRateAll = totalAll == 0 ? 0 : (wonAll * 100.0 / totalAll);

    var stageTotals = Model.AllStages.ToDictionary(
        s => s,
        s => Model.Rows.Sum(r => r.StageCounts.TryGetValue(s, out var v) ? v : 0)
    );

    var outcomeTotals = Model.AllOutcomes.ToDictionary(
        o => o,
        o => Model.Rows.Sum(r => r.OutcomeCounts.TryGetValue(o, out var v) ? v : 0)
    );

    string[] stageColors = {
        "#ffb71b",
        "#ffd16a",
        "#ffe3a3",
        "#f59e0b",
        "#3d3d3d",
        "#13a66f"
    };
}

<style>
    .pipeline-analysis-page {
        padding: 10px 0 40px;
    }

    .page-title {
        font-weight: 800;
        color: #2d2d2d;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: #8a8195;
        font-size: 14px;
        margin-bottom: 24px;
    }

    .pa-card {
        background: #fff;
        border: 0;
        border-radius: 22px;
        box-shadow: 0 12px 30px rgba(255, 183, 27, .13);
    }

    .kpi-card {
        padding: 20px;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .kpi-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 6px;
            height: 100%;
            background: #ffb71b;
        }

    .kpi-label {
        font-size: 12px;
        font-weight: 700;
        color: #8a8195;
    }

    .kpi-number {
        font-size: 28px;
        font-weight: 900;
        color: #2d2d2d;
        margin-top: 4px;
    }

    .kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: #fff7e3;
        color: #ffb71b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .analysis-section {
        margin-top: 24px;
        padding: 22px;
    }

    .section-title {
        font-weight: 800;
        color: #2d2d2d;
        margin-bottom: 2px;
    }

    .section-subtitle {
        color: #8a8195;
        font-size: 12px;
    }

    .table-responsive {
        margin-top: 18px;
    }

    .analysis-table {
        font-size: 13px;
        margin-bottom: 0;
    }

        .analysis-table thead th {
            background: #fff8e8;
            color: #2d2d2d;
            font-weight: 800;
            border-bottom: 1px solid #ffe1a0;
            white-space: nowrap;
            padding: 12px 10px;
        }

        .analysis-table tbody td {
            white-space: nowrap;
            padding: 13px 10px;
            vertical-align: middle;
            border-color: #f2f2f2;
        }

        .analysis-table tbody tr:hover {
            background: #fffaf0;
        }

        .analysis-table tfoot th {
            background: #fff8e8;
            color: #2d2d2d;
            font-weight: 800;
            border-top: 1px solid #ffe1a0;
            padding: 12px 10px;
            white-space: nowrap;
        }

    .user-main {
        font-weight: 800;
        color: #2d2d2d;
    }

    .user-sub {
        font-size: 11px;
        color: #8a8195;
    }

    .metric-muted {
        color: #8a8195;
        font-size: 11px;
    }

    .distribution-wrap {
        min-width: 330px;
    }

    .distribution-bar {
        height: 11px;
        border-radius: 999px;
        background: #eeeeee;
        overflow: hidden;
    }

    .distribution-label {
        font-size: 11px;
        color: #8a8195;
        margin-top: 6px;
        white-space: normal;
        line-height: 1.45;
    }

    .win-rate-box {
        min-width: 150px;
    }

    .progress {
        height: 9px;
        border-radius: 999px;
        background-color: #eeeeee;
        overflow: hidden;
    }

    .progress-bar-brand {
        background: #ffb71b;
    }

    .progress-bar-success {
        background: #13a66f;
    }

    .empty-row {
        opacity: .55;
    }

    @@media (max-width: 768px) {
        .analysis-section {
            padding: 16px;
        }

        .kpi-number {
            font-size: 24px;
        }
    }
</style>

<div class="pipeline-analysis-page">

    <h3 class="page-title">Pipeline Analizi</h3>
    <p class="page-subtitle">
        Firmanızdaki kullanıcıların pipeline aşamalarını ve satış sonuçlarını özet olarak görüntüleyin.
    </p>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="pa-card kpi-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-label">Toplam Görev</div>
                    <div class="kpi-number">@totalAll</div>
                </div>
                <div class="kpi-icon">
                    <i class="fa fa-list"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pa-card kpi-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="kpi-label">Kullanıcı Sayısı</div>
                    <div class="kpi-number">@usersCount</div>
                </div>
                <div class="kpi-icon">
                    <i class="fa fa-users"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pa-card kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="kpi-label">Genel Kazanma Oranı</div>
                        <div class="kpi-number">@winRateAll.ToString("0.0")%</div>
                    </div>
                    <div class="kpi-icon">
                        <i class="fa fa-trophy"></i>
                    </div>
                </div>

                <div class="progress mt-2">
                    <div class="progress-bar progress-bar-brand" style="width:@winRateAll.ToString("0.0")%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="pa-card analysis-section">
        <div>
            <h5 class="section-title">Aşamalar (Stage)</h5>
            <div class="section-subtitle">
                Her kullanıcı için pipeline aşama dağılımı gösterilir.
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle analysis-table">
                <thead>
                    <tr>
                        <th style="min-width:220px;">Kullanıcı</th>
                        <th class="text-end">Toplam</th>

                        @foreach (var st in Model.AllStages)
                        {
                            <th class="text-end">@st.GetDisplayName()</th>
                        }

                        <th>Dağılım</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var rowClass = row.Total == 0 ? "empty-row" : "";

                        <tr class="@rowClass">
                            <td>
                                <div class="user-main">
                                    @(string.IsNullOrWhiteSpace(row.NameSurname) ? row.UserName : row.NameSurname)
                                </div>
                                <div class="user-sub">@row.UserName</div>
                            </td>

                            <td class="text-end fw-bold">@row.Total</td>

                            @foreach (var st in Model.AllStages)
                            {
                                var count = row.StageCounts.TryGetValue(st, out var v) ? v : 0;
                                var pct = row.Total == 0 ? 0 : (count * 100.0 / row.Total);

                                <td class="text-end">
                                    @count <span class="metric-muted">(@pct.ToString("0.#")%)</span>
                                </td>
                            }

                            <td>
                                @{
                                    var pieces = new List<string>();
                                    var labelPieces = new List<string>();
                                    double acc = 0;
                                    var total = row.Total == 0 ? 1 : row.Total;

                                    for (int i = 0; i < Model.AllStages.Length; i++)
                                    {
                                        var st = Model.AllStages[i];
                                        var count = row.StageCounts.TryGetValue(st, out var v) ? v : 0;

                                        if (count > 0)
                                        {
                                            var percent = (count * 100.0) / total;
                                            var color = stageColors[i % stageColors.Length];

                                            pieces.Add($"{color} {acc:0.##}% {(acc + percent):0.##}%");
                                            labelPieces.Add($"{st.GetDisplayName()}: {count}");

                                            acc += percent;
                                        }
                                    }

                                    var bg = pieces.Count == 0
                                    ? "#eeeeee"
                                    : $"linear-gradient(to right, {string.Join(", ", pieces)})";
                                }

                                <div class="distribution-wrap">
                                    <div class="distribution-bar" style="background:@bg"></div>

                                    @if (labelPieces.Any())
                                    {
                                        <div class="distribution-label">
                                            @string.Join(" · ", labelPieces)
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>Genel Toplam</th>
                        <th class="text-end">@totalAll</th>

                        @foreach (var st in Model.AllStages)
                        {
                            var t = stageTotals[st];
                            var p = totalAll == 0 ? 0 : (t * 100.0 / totalAll);

                            <th class="text-end">
                                @t <span class="metric-muted">(@p.ToString("0.#")%)</span>
                            </th>
                        }

                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="pa-card analysis-section">
        <div>
            <h5 class="section-title">Sonuçlar (Outcome)</h5>
            <div class="section-subtitle">
                Kazanılan, kaybedilen ve süreçte kalan görevlerin kullanıcı bazlı dağılımı.
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle analysis-table">
                <thead>
                    <tr>
                        <th style="min-width:220px;">Kullanıcı</th>
                        <th class="text-end">Toplam</th>

                        @foreach (var oc in Model.AllOutcomes)
                        {
                            <th class="text-end">@oc.GetDisplayName()</th>
                        }

                        <th class="text-end">Kazanma Oranı</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var won = row.OutcomeCounts.TryGetValue(OutcomeTypeSales.Won, out var w) ? w : 0;
                        var winRate = row.Total == 0 ? 0 : (won * 100.0 / row.Total);
                        var rowClass = row.Total == 0 ? "empty-row" : "";

                        <tr class="@rowClass">
                            <td>
                                <div class="user-main">
                                    @(string.IsNullOrWhiteSpace(row.NameSurname) ? row.UserName : row.NameSurname)
                                </div>
                                <div class="user-sub">@row.UserName</div>
                            </td>

                            <td class="text-end fw-bold">@row.Total</td>

                            @foreach (var oc in Model.AllOutcomes)
                            {
                                var count = row.OutcomeCounts.TryGetValue(oc, out var v) ? v : 0;
                                var pct = row.Total == 0 ? 0 : (count * 100.0 / row.Total);

                                <td class="text-end">
                                    @count <span class="metric-muted">(@pct.ToString("0.#")%)</span>
                                </td>
                            }

                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2 win-rate-box">
                                    <span class="fw-bold">@winRate.ToString("0.0")%</span>
                                    <div class="progress flex-fill">
                                        <div class="progress-bar progress-bar-brand"
                                             style="width:@($"{winRate:0.##}%"); min-width:5px;">
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>Genel Toplam</th>
                        <th class="text-end">@totalAll</th>

                        @foreach (var oc in Model.AllOutcomes)
                        {
                            var t = outcomeTotals[oc];
                            var p = totalAll == 0 ? 0 : (t * 100.0 / totalAll);

                            <th class="text-end">
                                @t <span class="metric-muted">(@p.ToString("0.#")%)</span>
                            </th>
                        }

                        <th class="text-end">
                            <div class="d-inline-flex align-items-center gap-2 win-rate-box">
                                <span class="fw-bold">@winRateAll.ToString("0.0")%</span>
                                <div class="progress flex-fill">
                                    <div class="progress-bar progress-bar-brand"
                                         style="width:@winRateAll.ToString("0.0")%">
                                    </div>
                                </div>
                            </div>
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>